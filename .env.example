APP_NAME=News Intelligence API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_intelligence
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer

API_KEY=your-secret-api-key-here

# Comma-separated RSS feed URLs for the ingestion pipeline
RSS_FEEDS=https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://feeds.bbci.co.uk/news/rss.xml

# LLM Augmentation Settings (Local Ollama)
# Modes: "disabled" (deterministic only) | "local" (Ollama)
LLM_SERVICE_MODE=disabled
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_TIMEOUT=120
